rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function regularUser() {
      return signedIn() && request.auth.token.role != 'admin'
        && request.auth.token.role != 'masterAdmin'
        && request.auth.token.admin != true
        && request.auth.token.masterAdmin != true;
    }
    function validImage() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    // Profile photos for admins: only the account owner can read or write.
    match /admin-profile-photos/{userId}/{filename} {
      allow read: if signedIn() && request.auth.uid == userId && !regularUser();
      allow create, update: if signedIn() && request.auth.uid == userId && !regularUser() && validImage();
      allow delete: if signedIn() && request.auth.uid == userId && !regularUser();
    }
    match /profile-photos/{userId}/{filename} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if regularUser() && request.auth.uid == userId && validImage();
      allow delete: if regularUser() && request.auth.uid == userId;
    }
    match /items/{userId}/{filename} {
      allow read: if true;
      allow create, update: if regularUser() && request.auth.uid == userId && validImage();
      allow delete: if regularUser() && request.auth.uid == userId;
    }
    // No other upload paths are permitted.
  }
}
